# QUANT-ENGINE local configuration. NAMES ONLY: never commit real values.
# Copy to .env (gitignored) and run: chmod 600 .env
# The backend refuses a secrets file readable by group/others.
#
# CoinDCX API credentials. Only the backend reads these, at runtime. Public
# market scanning works without them. CoinDCX keys cannot be read-only, so a
# configured key can trade: keep it off shared machines and IP-bind it.
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Optional: read credentials from another protected file instead of ./.env
# QE_SECRETS_FILE=

# Execution mode. Default and every unknown value: paper.
# Live order submission ALSO needs the `live-orders` cargo feature, the operator
# confirmation phrase below set by the account owner, configured credentials,
# and a fully passing `live_readiness` checklist.
QE_EXECUTION_MODE=paper
# QE_LIVE_OPERATOR_CONFIRM=
